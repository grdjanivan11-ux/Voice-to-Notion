{
  "manifest_version": 3,
  "name": "Voice to Notion",
  "version": "0.1.1",
  "description": "Capture voice notes and send structured notes to Notion.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Voice to Notion",
    "default_popup": "popup.html",

    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "https://voice-to-notion-omega.vercel.app/*",
    "https://lxsveftgcjofmoloplwt.supabase.co/*"
  ]
}